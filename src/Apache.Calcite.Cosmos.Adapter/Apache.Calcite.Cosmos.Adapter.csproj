<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <Description>Apache Calcite adapter that plans queries against Azure Cosmos DB by generating Cosmos SQL.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>apache;calcite;cosmos;cosmosdb;azure;adapter;sql;ikvm</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.62.1" />
        <!-- 1.21.0 is a facade: every type moved to Azure.Core and comes back through
             TypeForwardedTo, which is why the package is 18KB and its only dependency is
             Azure.Core. Nothing here changes — DefaultAzureCredential and its options are
             among the forwarded types. -->
        <PackageReference Include="Azure.Identity" Version="1.21.0" />
        <!-- Required by Microsoft.Azure.Cosmos, which fails the build without an explicit reference. -->
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="IKVM" Version="8.15.0" />
        <PackageReference Include="IKVM.Java.Extensions" Version="8.15.0" />
        <PackageReference Include="IKVM.Maven.Sdk" Version="1.12.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Supplies the ClrAsyncEnumerable calling convention the converter targets. A prerelease, the
             conventions postdating the 1.0.3 release, but a tagged one from nuget.org. -->
        <PackageReference Include="Apache.Calcite.Extensions" Version="2.0.0-pre.7" />
        <!-- Held at the version Apache.Calcite.Extensions resolves core to. Core drags linq4j in with it,
             and the two are not separable: 1.42's BuiltInMethod initializer binds against 1.42's linq4j, so
             a disagreement here fails every query in a type initializer rather than at restore. -->
        <MavenReference Include="org.apache.calcite:calcite-core" Version="1.42.0" />
        <MavenReference Include="org.jooq:joou-java-6" Version="0.9.5" />
    </ItemGroup>

</Project>
